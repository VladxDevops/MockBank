# Docker ignore file for Project 1 container build
# Exclude files and directories that are not needed in the Docker build context.

# Git and local project metadata
.git
.gitignore
.gcloudignore

# Environment and secret files
.env
.env.*
!.env.example

# Dependencies and build artifacts
node_modules
dist/
build/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Terraform and cloud artifacts
.terraform
*.tfstate
*.tfstate.backup
*.tfvars
*.tfplan
.terraform.lock.hcl

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local data, logs, and temporary files
logs/
data/
tmp/
*.sqlite

# Local scripts and tooling not required for image runtime
start_local.sh
test-env.sh

# CI / deployment files not needed in runtime image
cloudbuild.yaml
cloudbuild-keycloak.yaml
mirror-keycloak.yaml
docker-compose.yaml

# Documentation and troubleshooting artifacts
*.md
TROUBLESHOOTING/

# Keep the realm export file needed by the container build
!realm-export.json
