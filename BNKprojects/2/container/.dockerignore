# Docker ignore file for Project 2
# Exclude files that should not be sent to the Docker build context.

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local environment and secret files
.env
.env.*

# Editor and IDE files
.vscode/
.idea/

# VCS metadata
.git/
.hg/

# OS files
.DS_Store
Thumbs.db

# Logs, temporary files, and build artifacts
logs/
*.log
tmp/
*.tmp
dist/
build/
coverage/

# Swap and editor temp files
*.swp
*~

# Local Docker/CICD and documentation files not needed for image build
docker-compose.yml
cloudbuild.yaml
README.md

# Keep the build context lean

